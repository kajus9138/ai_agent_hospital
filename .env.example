# Copie para .env (o scripts/setup.sh faz isso) e preencha só o que for usar.
# O Task Master usa o provider claude-code (main e fallback): não precisa de chave da Anthropic.

# Opcional: habilita o --research do Task Master (modelo sonar-pro)
PERPLEXITY_API_KEY=

# LLM local servido pelo Ollama
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# PostgreSQL onde ficam as threads (checkpoints do LangGraph)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_agent_hospital

# Servidor MCP externo com os dados de dengue (projeto smart_hospitals), iniciado via stdio.
# Clone de: https://github.com/kajus9138/smart_hospitals
SMART_HOSPITALS_PATH=/path/to/smart_hospitals
MCP_SERVER_COMMAND=uv
# Padrão abaixo (já embutido no config.py). Só descomente para mudar: o python-dotenv expande ${...}
# ao ler o .env e troca variável ausente por "" (mesmo entre aspas), escondendo um path faltando.
# MCP_SERVER_ARGS=run --directory ${SMART_HOSPITALS_PATH} dengue-mcp
